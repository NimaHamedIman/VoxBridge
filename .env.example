# VoxBridge environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to git.
# On the server, keep permissions strict: chmod 600 .env

# --- AI Backend ---
# "groq" is the default and the only fully implemented backend.
# "openai" and "ollama" exist as stubs for future use.
AI_BACKEND=groq

# Groq settings (required)
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Speech-to-Text ---
# Whisper model size: tiny, base, small, medium
# Bigger = more accurate, but slower and more RAM.
WHISPER_MODEL=base

# --- Language ---
# Default language for the local CLI mode (STT/TTS).
# The web API auto-detects the language per request.
LANGUAGE=de
